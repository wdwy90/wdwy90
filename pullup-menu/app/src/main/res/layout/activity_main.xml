<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="26sp" android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pull up to a restaurant and stop for ~20 seconds. Its photos show on your Android Auto screen, and the full menu opens on your phone." />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="1. Google Places API key" android:textStyle="bold" />
        <EditText
            android:id="@+id/api_key"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="AIza…" android:inputType="textVisiblePassword" android:singleLine="true" />
        <Button
            android:id="@+id/save_key"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Save key" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="2. Permissions" android:textStyle="bold" />
        <Button
            android:id="@+id/grant_permissions"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="3. Use it" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="In the car: open Pull Up Menu from the Android Auto app launcher. It watches automatically while open." />
        <Switch
            android:id="@+id/drive_mode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Phone-only drive mode (no Android Auto)" />
        <Button
            android:id="@+id/check_now"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="What restaurant am I at?" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
