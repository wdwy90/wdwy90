<?xml version="1.0" encoding="utf-8"?>
<!-- Tonal circle behind a category's icon; takes the accent tint while its category is open. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_soft" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_elevated" />
        </shape>
    </item>
</selector>
