<?xml version="1.0" encoding="utf-8"?>
<!-- 32dp pill inside a 48dp touch target. Selected: tonal accent (the solid accent is kept for Navigate). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="8dp" android:insetBottom="8dp">
    <ripple android:color="@color/ripple">
        <item>
            <selector android:enterFadeDuration="150" android:exitFadeDuration="150">
                <item android:state_selected="true">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/accent_soft" />
                        <corners android:radius="999dp" />
                        <stroke android:width="1dp" android:color="@color/accent_soft" />
                    </shape>
                </item>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@color/surface" />
                        <corners android:radius="999dp" />
                        <stroke android:width="1dp" android:color="@color/divider" />
                    </shape>
                </item>
            </selector>
        </item>
    </ripple>
</inset>
