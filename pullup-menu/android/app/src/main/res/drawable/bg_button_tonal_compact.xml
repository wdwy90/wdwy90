<?xml version="1.0" encoding="utf-8"?>
<!-- 40dp pill inside a 48dp touch target (restaurant header). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="4dp" android:insetBottom="4dp">
    <ripple android:color="@color/ripple">
        <item><shape android:shape="rectangle"><solid android:color="@color/surface_elevated" /><corners android:radius="999dp" /></shape></item>
    </ripple>
</inset>
