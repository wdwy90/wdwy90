<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter"
        android:paddingTop="@dimen/space_2" android:paddingBottom="@dimen/space_3">

        <!-- Header: icon, name, tagline, settings -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    style="@style/Text.Headline"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name" />
                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/tagline" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/settings_button"
                style="@style/IconButton"
                android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <!-- Detection status pill -->
        <LinearLayout
            android:id="@+id/status_pill"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="14dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:background="@drawable/bg_pill_neutral">
            <View
                android:id="@+id/pill_dot"
                android:layout_width="8dp" android:layout_height="8dp"
                android:background="@drawable/dot" />
            <TextView
                android:id="@+id/pill_text"
                style="@style/Text.Label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Status card -->
        <LinearLayout
            android:id="@+id/status_card"
            style="@style/Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="vertical"
            android:accessibilityLiveRegion="polite">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <!-- Indicator: a dot with a ring that pulses while searching or watching. -->
                <FrameLayout
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:importantForAccessibility="noHideDescendants">
                    <View
                        android:id="@+id/indicator_ring"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/dot"
                        android:alpha="0.18" />
                    <View
                        android:id="@+id/indicator_dot"
                        android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:background="@drawable/dot" />
                </FrameLayout>
                <TextView
                    android:id="@+id/status_title"
                    style="@style/Text.Headline"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_body"
                style="@style/Text.Secondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/status_action"
                style="@style/Button.Primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />

            <View
                android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="@dimen/gutter"
                android:background="@color/divider" />

            <include android:id="@+id/fact_car" layout="@layout/item_fact" />
            <include android:id="@+id/fact_auto" layout="@layout/item_fact" />
            <include android:id="@+id/fact_current" layout="@layout/item_fact" />
            <include android:id="@+id/fact_last" layout="@layout/item_fact" />
        </LinearLayout>

        <TextView
            style="@style/Text.Overline"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:layout_marginStart="4dp"
            android:accessibilityHeading="true"
            android:text="Quick actions" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <include android:id="@+id/action_detect" layout="@layout/item_action"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <Space android:layout_width="12dp" android:layout_height="1dp" />
            <include android:id="@+id/action_menu" layout="@layout/item_action"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <include android:id="@+id/action_drive" layout="@layout/item_action"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <Space android:layout_width="12dp" android:layout_height="1dp" />
            <include android:id="@+id/action_settings" layout="@layout/item_action"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:text="In the car, open Pull Up Menu from the Android Auto launcher." />
        <Button
            android:id="@+id/demo"
            style="@style/Button.Text"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="Try a demo" />
    </LinearLayout>
</ScrollView>
