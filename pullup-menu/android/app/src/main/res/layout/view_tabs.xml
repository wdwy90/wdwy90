<?xml version="1.0" encoding="utf-8"?>
<!-- Segmented tab bar; the indicator slides behind the selected tab (see TabBar). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_track"
    android:layout_width="match_parent" android:layout_height="@dimen/touch_target"
    android:background="@drawable/bg_tabs">
    <View
        android:id="@+id/tab_indicator"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:layout_gravity="left|top"
        android:background="@drawable/bg_tab_indicator"
        android:elevation="1dp"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal"
        android:elevation="1dp">
        <TextView android:id="@+id/tab_items" style="@style/Tab"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Items" />
        <TextView android:id="@+id/tab_menu" style="@style/Tab"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Menu" />
        <TextView android:id="@+id/tab_photos" style="@style/Tab"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Photos" />
    </LinearLayout>
</FrameLayout>
