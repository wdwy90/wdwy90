<?xml version="1.0" encoding="utf-8"?>
<!-- One label/value line in the status card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:layout_marginTop="4dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:focusable="true"
    android:importantForAccessibility="yes">
    <ImageView
        android:id="@+id/fact_icon"
        android:layout_width="20dp" android:layout_height="20dp"
        android:tint="@color/text_secondary"
        android:importantForAccessibility="no" />
    <!-- Label at the start and value at the end; the value goes under the label when they don't
         fit side by side (long names, small phones, large text). -->
    <com.wdwy90.pullupmenu.phone.FlowRow
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        app:flowGap="@dimen/space_2"
        app:flowLineGap="2dp"
        app:flowSpread="true">
        <TextView
            android:id="@+id/fact_label"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/fact_value"
            style="@style/Text.Body"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:importantForAccessibility="no" />
    </com.wdwy90.pullupmenu.phone.FlowRow>
</LinearLayout>
