<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="@dimen/gutter">
        <ImageButton
            android:id="@+id/back"
            style="@style/IconButton"
            android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />
        <TextView
            style="@style/Text.Headline"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:accessibilityHeading="true"
            android:text="@string/settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/space_3">

            <!-- Detection -->
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_marginTop="8dp"
                android:accessibilityHeading="true" android:text="Detection" />
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="vertical">
                <Switch
                    android:id="@+id/auto_detect"
                    style="@style/Switch"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Auto-detect drive-thrus" />
                <TextView style="@style/Text.Secondary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="On: Pull Up Menu watches while Android Auto or Drive Mode is running, and the menu opens by itself. Off: tap Detect My Restaurant in the lane." />
                <LinearLayout
                    android:id="@+id/auto_detect_options"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_2" android:layout_marginBottom="8dp"
                        android:background="@color/divider" />
                    <Switch
                        android:id="@+id/car_banner"
                        style="@style/Switch"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Car banner (experimental)" />
                    <TextView style="@style/Text.Secondary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Shows a banner on the car screen when a drive-thru is found. Tap it to open the card." />
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_2" android:layout_marginBottom="8dp"
                        android:background="@color/divider" />
                    <Switch
                        android:id="@+id/drive_mode"
                        style="@style/Switch"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Drive Mode on this phone" />
                    <TextView style="@style/Text.Secondary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="For drives without Android Auto. It stops by itself after 15 minutes parked. The Pull Up Menu home-screen widget starts it with one tap." />
                </LinearLayout>
            </LinearLayout>

            <!-- Permissions -->
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_3"
                android:accessibilityHeading="true" android:text="Permissions" />
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="vertical">
                <include android:id="@+id/fact_location" layout="@layout/item_fact" />
                <include android:id="@+id/fact_notifications" layout="@layout/item_fact" />
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal">
                    <Button
                        android:id="@+id/grant_permissions"
                        style="@style/Button.Primary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Allow" />
                    <Button
                        android:id="@+id/app_settings"
                        style="@style/Button.Tonal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="System settings" />
                </LinearLayout>
            </LinearLayout>

            <!-- Android Auto -->
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_3"
                android:accessibilityHeading="true" android:text="Android Auto" />
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="vertical">
                <include android:id="@+id/fact_car" layout="@layout/item_fact" />
                <TextView style="@style/Text.Secondary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="In the car, open Pull Up Menu from the Android Auto launcher. The car screen shows the restaurant and its item list; the full menu page and photos stay on the phone, for when you’re parked." />
            </LinearLayout>

            <!-- Places API -->
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_3"
                android:accessibilityHeading="true" android:text="Google Places API" />
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="vertical">
                <include android:id="@+id/fact_key_source" layout="@layout/item_fact" />
                <include android:id="@+id/fact_key" layout="@layout/item_fact" />
                <Button
                    android:id="@+id/change_key"
                    style="@style/Button.Tonal"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Change key" />

                <!-- Editor: always starts empty; the saved key is never put back on screen. -->
                <LinearLayout
                    android:id="@+id/key_editor"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <EditText
                        android:id="@+id/api_key"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:background="@drawable/bg_search"
                        android:paddingStart="@dimen/space_2" android:paddingEnd="@dimen/space_2"
                        android:hint="Paste a new key"
                        android:inputType="textPassword|textNoSuggestions"
                        android:importantForAutofill="no"
                        android:saveEnabled="false"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/key_error"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/warning"
                        android:accessibilityLiveRegion="polite"
                        android:visibility="gone" />
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:orientation="horizontal">
                        <Button
                            android:id="@+id/cancel_key"
                            style="@style/Button.Tonal"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Cancel" />
                        <Button
                            android:id="@+id/save_key"
                            style="@style/Button.Primary"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Save" />
                    </LinearLayout>
                </LinearLayout>
                <Button
                    android:id="@+id/remove_key"
                    style="@style/Button.Text"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Remove my key" />
            </LinearLayout>

            <!-- Appearance -->
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_3"
                android:accessibilityHeading="true" android:text="Appearance" />
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="vertical"
                android:paddingTop="8dp" android:paddingBottom="8dp">
                <RadioGroup
                    android:id="@+id/theme_group"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:contentDescription="Theme">
                    <RadioButton android:id="@+id/theme_dark" style="@style/Radio"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dark" />
                    <RadioButton android:id="@+id/theme_light" style="@style/Radio"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Light" />
                    <RadioButton android:id="@+id/theme_system" style="@style/Radio"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Match system" />
                </RadioGroup>
            </LinearLayout>

            <!-- Troubleshooting -->
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_marginTop="@dimen/space_3"
                android:accessibilityHeading="true" android:text="Troubleshooting" />
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="vertical">
                <include android:id="@+id/fact_version" layout="@layout/item_fact" />
                <include android:id="@+id/fact_data" layout="@layout/item_fact" />
                <include android:id="@+id/fact_radius" layout="@layout/item_fact" />
                <TextView style="@style/Text.Secondary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Not showing on the car screen? Install from Google Play (not a downloaded APK), then open Android Auto on the phone and check that Pull Up Menu is listed under Customize launcher.\n\nNo restaurant found? Detection needs location on and looks within the radius above. Try Detect My Restaurant once you’re in the lane." />
                <Button
                    android:id="@+id/demo"
                    style="@style/Button.Tonal"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="Try a demo" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
