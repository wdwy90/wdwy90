<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the settings file (which can hold the user's own Places API key) is neither backed up
     to the cloud nor copied to a new phone. allowBackup="false" covers older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
