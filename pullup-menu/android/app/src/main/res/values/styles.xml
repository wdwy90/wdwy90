<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type scale (Material 3 sizes, platform Roboto / Google Sans on Pixel via sans-serif). -->
    <style name="Text" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>
    <style name="Text.Display">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingExtra">0sp</item>
    </style>
    <style name="Text.Headline">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">0sp</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Text.Secondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="Text.Overline">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Card container -->
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">@dimen/card_elevation</item>
        <item name="android:padding">@dimen/gutter</item>
    </style>

    <!-- Pill buttons -->
    <style name="Button" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>
    <style name="Button.Tonal">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="Button.Text">
        <item name="android:background">@drawable/bg_ripple_pill</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_ripple_circle</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Switch" parent="@android:style/Widget.DeviceDefault.CompoundButton.Switch">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
    </style>

    <style name="Radio" parent="@android:style/Widget.DeviceDefault.CompoundButton.RadioButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:buttonTint">@color/accent</item>
        <item name="android:paddingStart">8dp</item>
    </style>

    <style name="Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:background">@drawable/bg_ripple_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Chip">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Tag">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/warning</item>
        <item name="android:background">@drawable/bg_tag_warning</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
</resources>
